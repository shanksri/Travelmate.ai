# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the base URL (gateway/proxy)
# ANTHROPIC_BASE_URL=

# Agent behaviour
TRAVELMATE_MODEL=claude-opus-5
TRAVELMATE_EFFORT=high
TRAVELMATE_MAX_TOKENS=16000
TRAVELMATE_MAX_TOOL_ITERATIONS=24

# Travel data providers: "mock" (deterministic, no keys) or "live"
TRAVELMATE_PROVIDER=mock

# API
TRAVELMATE_LOG_LEVEL=INFO
