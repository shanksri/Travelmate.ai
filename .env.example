# --- LLM provider ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...

# --- Travel data providers ----------------------------------------------------
# Real flight fares when TRAVELMATE_PROVIDER=live. Must be the 32-character hex
# token from the Aviasales program's own API section in Travelpayouts — the
# longer "travelpayouts-..." token from the general partner-tools page gets 401.
TRAVELPAYOUTS_API_KEY=
# Standalone clients and MCP servers only — not used by the planner itself.
AVIATION_API_KEY=
TAVILY_API_KEY=

# --- Observability (not wired into any code yet) -----------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travelmate.ai

# --- Agent behaviour ----------------------------------------------------------
TRAVELMATE_MODEL=gpt-4o-mini
TRAVELMATE_TEMPERATURE=0.3
TRAVELMATE_MAX_TOKENS=16000
TRAVELMATE_MAX_ITINERARY_RETRIES=2

# Travel data providers: "mock" (deterministic, no keys) or "live" (real
# flight fares from Travelpayouts; lodging, attractions and weather stay mock).
# Settings are cached per process, so restart the server after changing this.
TRAVELMATE_PROVIDER=mock

# Trip storage: "memory" (default, no setup) or "postgres" (see
# docker-compose.yml — the "db" service matches this connection string when
# running the api container itself; use "localhost" instead of "db" when
# running the api outside Docker against `docker compose up db`)
TRAVELMATE_STORE=memory
TRAVELMATE_DATABASE_URL=postgresql+psycopg://travelmate:travelmate@localhost:5433/travelmate

# API
TRAVELMATE_LOG_LEVEL=INFO
