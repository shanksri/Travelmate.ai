# Groq
GROQ_API_KEY=gsk_...
# Optional: override the base URL (gateway/proxy)
# GROQ_BASE_URL=

# Agent behaviour
TRAVELMATE_MODEL=llama-3.3-70b-versatile
TRAVELMATE_TEMPERATURE=0.3
TRAVELMATE_MAX_TOKENS=4096
TRAVELMATE_MAX_ITINERARY_RETRIES=2

# Travel data providers: "mock" (deterministic, no keys) or "live"
TRAVELMATE_PROVIDER=mock

# API
TRAVELMATE_LOG_LEVEL=INFO
