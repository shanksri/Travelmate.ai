# --- LLM provider ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...

# --- Travel data providers (not wired into any code yet — TRAVELMATE_PROVIDER
# stays "mock" until a live TravelProvider implementation exists) -----------
AVIATION_API_KEY=
TAVILY_API_KEY=

# --- Observability (not wired into any code yet) -----------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travelmate.ai

# --- Agent behaviour ----------------------------------------------------------
TRAVELMATE_MODEL=gpt-4o-mini
TRAVELMATE_TEMPERATURE=0.3
TRAVELMATE_MAX_TOKENS=4096
TRAVELMATE_MAX_ITINERARY_RETRIES=2

# Travel data providers: "mock" (deterministic, no keys) or "live"
TRAVELMATE_PROVIDER=mock

# Trip storage: "memory" (default, no setup) or "postgres" (see
# docker-compose.yml — the "db" service matches this connection string when
# running the api container itself; use "localhost" instead of "db" when
# running the api outside Docker against `docker compose up db`)
TRAVELMATE_STORE=memory
TRAVELMATE_DATABASE_URL=postgresql+psycopg://travelmate:travelmate@localhost:5433/travelmate

# API
TRAVELMATE_LOG_LEVEL=INFO
